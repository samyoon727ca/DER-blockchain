{
  "name": "der-energy-marketplace-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: tokenized distributed-energy credits and a peer-to-peer energy marketplace on a local Hardhat chain.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc --noEmit",
    "demo": "hardhat compile --quiet && ts-node scripts/demo.ts",
    "demo:fast": "hardhat compile --quiet && ts-node scripts/demo.ts --fast --exit",
    "report": "ts-node scripts/report.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
